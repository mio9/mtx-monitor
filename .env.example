MTX_API_URL=http://127.0.0.1:9997
# RTSP base URL for ffmpeg/ffplay watch (defaults to api host on port 8554)
MTX_RTSP_URL=rtsp://127.0.0.1:8554
# Player binary for watch (ffplay from ffmpeg package)
WATCH_PLAYER=ffplay
# Basic auth (internal authMethod)
MTX_API_USER=
MTX_API_PASSWORD=
# Bearer token (JWT authMethod; takes precedence over basic)
MTX_API_TOKEN=
# Only enforce paths whose name matches this regex (omit to enforce all)
PATH_INCLUDE_REGEX=^live/
POLL_INTERVAL_SEC=3
MAX_BITRATE_KBPS=5000
